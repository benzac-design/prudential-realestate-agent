# Google AI Studio (Gemini)
GOOGLE_API_KEY=your_google_ai_studio_api_key

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Resend (Email)
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=agent@yourdomain.com

# Supabase (Database)
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_secret_key

# MiniMax (AI model)
MINIMAX_API_KEY=your_minimax_api_key

# Agent identity (used in AI conversations + alerts)
DEFAULT_AGENT_ID=default
DEFAULT_AGENT_NAME=Jane Smith
DEFAULT_AGENT_EMAIL=jane@youragency.com
DEFAULT_AGENCY=Prudential Real Estate
# Optional: a Cal.com / Calendly link the AI shares when a lead wants to book
BOOKING_LINK=https://cal.com/your-agent/viewing

# App
SECRET_KEY=change_this_to_a_random_string
APP_URL=https://your-vercel-url.vercel.app
